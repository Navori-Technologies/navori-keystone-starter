{
  "name": "keystone-app",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "keystone dev",
    "start": "keystone start",
    "build": "keystone build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "db:seed": "bun run scripts/seed/index.ts",
    "db:nuke": "bun run scripts/nuke-db.ts",
    "db:nuke:seed": "bun run db:nuke && bun run db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/lib-storage": "3.1137.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@keystone-6/auth": "^10.0.2",
    "@keystone-6/core": "^8.0.4",
    "@keystone-6/fields-document": "^11.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "18.0.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "next": "^16.2.10",
    "pg": "8.23.0",
    "prisma": "^7.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "supertest": "7.2.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
