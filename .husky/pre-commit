#!/usr/bin/env sh
# Pre-commit: tsc + oxlint + oxfmt. INFORMATIONAL — never blocks the commit.
#
# Scoped to staged files for lint/format (running it over the whole repo
# would dump every pre-existing warning on every commit, and a warning that
# always fires is one people learn to ignore). `tsc` can't be scoped that
# way — it checks the whole project or nothing — and runs in full on
# purpose: a change in one file breaking another file's types is exactly
# what this should catch.
#
# The trade-off, spelled out: this no longer blocks committing code that
# doesn't compile. CI (.github/workflows/ci.yml) is the hard gate.

failed=''

run_check() {
  label="$1"
  shift
  printf '\n\033[1m▶ %s\033[0m\n' "$label"
  if "$@"; then
    printf '\033[32m  ✔ %s\033[0m\n' "$label"
  else
    printf '\033[31m  ✘ %s\033[0m\n' "$label"
    failed="${failed}${label}, "
  fi
}

# Only what's in THIS commit. --diff-filter=ACMR drops deletions: linting a
# file that no longer exists fails for the wrong reason.
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

run_check 'tsc --noEmit' bunx tsc --noEmit

if [ -n "$staged" ]; then
  # shellcheck disable=SC2086 # word splitting is the point: one arg per file
  run_check 'oxlint (staged)' bunx oxlint $staged
  # shellcheck disable=SC2086
  run_check 'oxfmt --check (staged)' bunx oxfmt --check $staged
else
  printf '\n\033[2m▶ oxlint / oxfmt: no staged JS/TS files, skipping\033[0m\n'
fi

if [ -n "$failed" ]; then
  printf '\n\033[1;33m┌─────────────────────────────────────────────────────────────┐\033[0m\n'
  printf '\033[1;33m│  COMMITTED ANYWAY — this doesn'\''t block, but it is failing:  │\033[0m\n'
  printf '\033[1;33m└─────────────────────────────────────────────────────────────┘\033[0m\n'
  printf '  \033[31m%s\033[0m\n' "${failed%, }"
  printf '  Quick fix: \033[1mbun run lint && bun run format\033[0m\n\n'
fi

exit 0
