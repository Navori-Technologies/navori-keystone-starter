# ── Database — see keystone.ts / prisma.config.ts ──────────────────────────
# Matches docker-compose.yml's `db` service. Change if you point at a
# different Postgres.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Signs session cookies (@keystone-6/core/session). If unset, Keystone
# generates a random one per process start — fine for a quick local run, but
# every restart invalidates existing sessions. Set a real one anywhere you
# want sessions to survive a restart. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-minimum-32-characters-long

# ── Storage — see storage.ts ────────────────────────────────────────────────
# 'local' writes to ./uploads, nothing else to set. Switch to 's3' for any
# S3-compatible object store (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./uploads

# Required when STORAGE_DRIVER=s3:
# S3_BUCKET_NAME=my-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # e.g. https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2 — unset for real AWS S3

# ── Logging — see logger.ts ─────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=debug

# ── Security — see server.ts ────────────────────────────────────────────────
MAX_JSON_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Data seed — see scripts/seed, `bun run db:seed` ────────────────────────
# Optional: rows created per list (all lists share this).
# SEED_QUANTITY=20
# Optional: makes faker's output deterministic — set to reproduce a run.
# SEED_FAKER_SEED=42
