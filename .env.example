DATABASE_URL=postgresql://app:app@localhost:5432/app
SESSION_SECRET=change-me-minimum-32-characters-long

# Storage — see storage.ts. 'local' writes to ./uploads, no setup needed.
STORAGE_DRIVER=local
# Switch to 's3' for any S3-compatible store (AWS S3, Cloudflare R2, MinIO):
# STORAGE_DRIVER=s3
# S3_BUCKET_NAME=my-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT= # e.g. https://<account_id>.r2.cloudflarestorage.com for R2; unset for real AWS S3

LOG_LEVEL=debug

# Security — see server.ts.
MAX_JSON_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
