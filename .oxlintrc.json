{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".keystone", "generated", "node_modules"],
  "overrides": [
    {
      "files": ["tests/**/*.test.ts"],
      "plugins": ["vitest"]
    }
  ]
}
